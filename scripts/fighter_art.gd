142 189L131 192\" fill=\"none\" stroke=\"#c9effa\" stroke-opacity=\".5\"/></g></svg>"}}
static var cache = {}

static func texture(fighter, pose = "idle", profile = {}):
	if not ART.has(fighter):
		fighter = "person"
	var gender = "Female" if str(profile.get("gender", "Male")).to_lower().begins_with("f") else "Male"
	var look = Data.complete(profile.get("look", {}), gender, int(profile.get("seed", 0)))
	var outfit = Data.OUTFITS.get(profile.get("outfit", "martial"), Data.OUTFITS["martial"])
	var key = str([fighter, pose, look, outfit, gender])
	if cache.has(key):
		return cache[key]
	var source = ART[fighter].get(pose, ART[fighter]["idle"])
	source = source.replace("__ROBE__", "#" + outfit[0]).replace("__TRIM__", "#" + outfit[1])
	source = source.replace("__SKIN__", "#" + Data.SKINS[look["skin"]][1]).replace("__HAIR__", "#" + Data.HAIR_COLOURS[look["hair_colour"]][1])
	if fighter == "hero" and look["hair"] in [1, 3, 4]:
		var bun = '<path d="M87 27Q74 5 97 8Q109 11 103 25Z" fill="__HAIR__"/>'
		bun = bun.replace("__HAIR__", "#" + Data.HAIR_COLOURS[look["hair_colour"]][1])
		source = source.replace(bun, "")
	if fighter == "hero" and (gender == "Female" or look["hair"] in [1, 2]):
		var locks = '<path d="M84 32Q67 48 76 93L63 119Q92 97 93 60Z" fill="#%s" stroke="#111625" stroke-width="2"/>' % Data.HAIR_COLOURS[look["hair_colour"]][1]
		source = source.replace('<g stroke=', locks + '<g stroke=')
	var picture = Image.new()
	if picture.load_svg_from_string(source) != OK:
		return null
	picture.generate_mipmaps()
	var result = ImageTexture.create_from_image(picture)
	if cache.size() >= 48:
		cache.clear()
	cache[key] = result
	return result
